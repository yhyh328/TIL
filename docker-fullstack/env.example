# 데이터베이스 설정
DB_USER=appuser
DB_PASSWORD=your-secure-password-here
DB_NAME=appdb
DB_PORT=5432

# 백엔드 설정
BACKEND_PORT=8080
SPRING_PROFILE=prod
# 첫 배포: update (테이블 자동 생성), 이후: validate (스키마 검증만)
SPRING_DDL_AUTO=update
SPRING_SHOW_SQL=false

# 프론트엔드 설정
FRONTEND_PORT=80
API_URL=http://localhost:8080

# CORS 설정 (프론트엔드 도메인 목록, 쉼표로 구분)
# 예: ALLOWED_ORIGINS=http://localhost:80,https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:80

